# Entornos virtuales
.venv/
.venv-legacy/

# Pesos del modelo (descargables, ~1.3 GB)
models/

# Python
__pycache__/
*.py[cod]

# Salidas locales
logs/*.log

# Audio descargado (reproducible con scripts/prepare_sample.py)
data/samples/*.wav
data/samples/*.gz

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Cach�s y archivos temporales
.pytest_cache/
.ruff_cache/
.streamlit/secrets.toml
*.tmp
*.temp

# Pesos de modelos en otros formatos
*.safetensors
*.bin
*.pt

# Secretos y credenciales
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials*
*.api_key

# Logs de ejecución (archivos temporales)
logs/
